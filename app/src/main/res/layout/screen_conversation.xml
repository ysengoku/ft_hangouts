<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ListView
        android:id="@+id/message_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:stackFromBottom="true"
        android:clipToPadding="false"
        android:paddingTop="@dimen/spacing_extra_small"
        android:divider="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_small"
        android:orientation="horizontal"
        android:gravity="bottom">

        <EditText
            android:id="@+id/message_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="@dimen/message_input_height"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:paddingVertical="@dimen/spacing_small"
            android:background="@drawable/bg_search_bar"
            android:hint="@string/message_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:textAppearance="@style/TextAppearance.FTHangouts.BodyLarge"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/message_send"
            style="@style/Widget.FTHangouts.IconButton"
            android:layout_width="@dimen/message_input_height"
            android:layout_height="@dimen/message_input_height"
            android:layout_marginStart="@dimen/spacing_small"
            android:src="@drawable/ic_send"
            android:tint="?android:attr/colorPrimary"
            android:contentDescription="@string/send_message" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:id="@+id/form_field_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/text_field_label_offset"
            android:minHeight="@dimen/text_field_height"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:background="@drawable/bg_text_field"
            android:textAppearance="@style/TextAppearance.FTHangouts.BodyLarge"
            android:textColor="?attr/colorOnSurface"
            android:maxLength="@integer/max_length_name"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/form_field_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/text_field_label_start"
            android:paddingHorizontal="@dimen/spacing_extra_small"
            android:background="?android:attr/colorBackground"
            android:textAppearance="@style/TextAppearance.FTHangouts.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </FrameLayout>

    <TextView
        android:id="@+id/form_field_feedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_extra_small"
        android:paddingHorizontal="@dimen/spacing_medium"
        android:textAppearance="@style/TextAppearance.FTHangouts.BodySmall"
        android:textColor="?android:attr/colorError"
        android:visibility="gone"
    />
</LinearLayout>

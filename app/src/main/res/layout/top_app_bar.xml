<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/top_app_bar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/top_app_bar_height"
    android:paddingHorizontal="@dimen/spacing_extra_small"
    android:gravity="center_vertical"
    android:background="@drawable/bg_top_app_bar" >

    <ImageButton
        android:id="@+id/top_app_bar_navigation"
        style="@style/Widget.FTHangouts.IconButton"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:layout_gravity="start|center_vertical"
        android:src="@drawable/ic_arrow_back"
        android:contentDescription="@string/back"
        android:visibility="gone" />

    <!-- <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <include
            android:id="@+id/top_app_bar_title_avatar"
            layout="@layout/view_avatar"
            android:layout_width="@dimen/avatar_size_small"
            android:layout_height="@dimen/avatar_size_small"
            android:visibility="gone" /> -->
        <TextView
            android:id="@+id/top_app_bar_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="@dimen/icon_button_size"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.FTHangouts.TitleLarge"
            android:textColor="?attr/colorOnPrimaryContainer" />
    <!-- <LinearLayout> -->

    <ImageButton
        android:id="@+id/top_app_bar_action"
        style="@style/Widget.FTHangouts.IconButton"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:layout_gravity="end|center_vertical"
        android:src="@drawable/ic_palette"
        android:contentDescription="@string/change_color_theme" />
</FrameLayout>

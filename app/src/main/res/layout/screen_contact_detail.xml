<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/spacing_medium">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="@dimen/spacing_medium">

        <include
            android:id="@+id/contact_detail_avatar"
            layout="@layout/view_avatar"
            android:layout_width="@dimen/avatar_size_large"
            android:layout_height="@dimen/avatar_size_large" />

        <TextView
            android:id="@+id/contact_detail_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="@dimen/spacing_small"
            android:textColor="?attr/colorOnSurface"
            android:textAppearance="@style/TextAppearance.FTHangouts.HeadlineSmall" />
        
        <TextView
            android:id="@+id/contact_detail_placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="?attr/colorOnSurface"
            android:textAppearance="@style/TextAppearance.FTHangouts.TitleMedium" />
    </LinearLayout>
</ScrollView>

    </style>

    <style name="Widget.FTHangouts.IconButton" parent="@android:style/Widget.Material.ImageButton">
        <item name="android:padding">@dimen/icon_button_padding</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">?attr/colorOnPrimaryContainer</item>
    </style>

    <style name="Widget.FTHangouts.TonalIconButton" parent="@android:style/Widget.Material.ImageButton">
        <item name="android:background">@drawable/bg_tonal_icon_button</item>
        <item name="android:padding">@dimen/tonal_icon_button_padding</item>
        <item name="android:tint">?attr/colorOnSecondaryContainer</item>
    </style>

    <style name="Widget.FTHangouts.FieldButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/bg_field_button</item>
        <item name="android:textAppearance">@style/TextAppearance.FTHangouts.BodyLarge</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">@dimen/spacing_medium</item>
        <item name="android:minHeight">@dimen/tonal_icon_button_height</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:drawablePadding">@dimen/spacing_medium</item>
    </style>

    <style name="ThemeOverlay.FTHangouts.Dialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurface</item>
        <item name="android:colorAccent">?attr/colorOnSurfaceVariant</item>
    </style>

</resources>
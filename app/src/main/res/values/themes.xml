<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base Parent Theme using Android Framework Theme -->
    <style name="Base.Theme.FtHangouts" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/noto_sans</item>
        <item name="android:colorPrimary">@color/ocean_primary</item>
        <item name="android:colorAccent">@color/ocean_secondary</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.FTHangouts.Dialog</item>
    </style>

    <!-- Default Theme referenced in AndroidManifest.xml -->
    <style name="Theme.FtHangouts" parent="Theme.FtHangouts.Ocean" />

    <style name="TextAppearance.FTHangouts.DisplayMedium" parent="@android:style/TextAppearance">
        <item name="android:fontFamily">@font/noto_sans</item>
        <item name="android:textSize">45sp</item>
    </style>

    <style name="TextAppearance.FTHangouts.HeadlineMedium" parent="@android:style/TextAppearance">
        <item name="android:fontFamily">@font/noto_sans</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="TextAppearance.FTHangouts.HeadlineSmall" parent="@android:style/TextAppearance">
        <item name="android:fontFamily">@font/noto_sans</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="TextAppearance.FTHangouts.TitleLarge" parent="@android:style/TextAppearance">
        <item name="android:fontFamily">@font/noto_sans</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="TextAppearance.FTHangouts.TitleMedium" parent="@android:style/TextAppearance">
        <item name="android:fontFamily">@font/noto_sans_medium</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.FTHangouts.BodyLarge" parent="@android:style/TextAppearance">
        <item name="android:fontFamily">@font/noto_sans</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.FTHangouts.LabelLarge" parent="@android:style/TextAppearance">
        <item name="android:fontFamily">@font/noto_sans_medium</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- ==================== OCEAN THEME ==================== -->
    <style name="Theme.FtHangouts.Ocean" parent="Base.Theme.FtHangouts">
        <item name="android:colorPrimary">@color/ocean_primary</item>
        <item name="android:colorAccent">@color/ocean_secondary</item>
        <item name="android:colorBackground">@color/ocean_background</item>
        <item name="android:windowBackground">@color/ocean_background</item>
        <item name="android:textColorPrimary">@color/ocean_on_background</item>
        <item name="android:colorError">@color/ocean_error</item>
        <item name="colorOnPrimary">@color/ocean_on_primary</item>
        <item name="colorPrimaryContainer">@color/ocean_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/ocean_on_primary_container</item>
        <item name="colorOnSurface">@color/ocean_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/ocean_on_surface_variant</item>
        <item name="colorSecondaryContainer">@color/ocean_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/ocean_on_secondary_container</item>
        <item name="colorTertiaryContainer">@color/ocean_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/ocean_on_tertiary_container</item>
        <item name="colorSurfaceContainerHigh">@color/ocean_surface_container_high</item>
    </style>


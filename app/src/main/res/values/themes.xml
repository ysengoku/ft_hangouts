        <item name="colorOnPrimaryContainer">@color/lavender_on_primary_container</item>
        <item name="colorOnSurface">@color/lavender_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/lavender_on_surface_variant</item>
        <item name="colorSecondaryContainer">@color/lavender_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/lavender_on_secondary_container</item>
        <item name="colorTertiaryContainer">@color/lavender_tertiary_container</item>
